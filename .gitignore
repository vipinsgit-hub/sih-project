# Keep data and output directories tracked via .gitkeep
data/input/*
!data/input/.gitkeep
data/cadastral/*
!data/cadastral/.gitkeep
!data/cadastral/demo_cadastral.geojson
outputs/*
!outputs/.gitkeep
